integrator = md
dt = 0.002
nsteps = 100000000     ; 200 ns (overridden by -nsteps)
nstlog = 25000
nstenergy = 5000
nstcalcenergy = 100
nstxout-compressed = 25000   ; 50 ps
continuation = no
cutoff-scheme = Verlet
nstlist = 20
rlist = 1.2
coulombtype = pme
rcoulomb = 1.2
vdwtype = cut-off
vdw-modifier = force-switch
rvdw-switch = 1.0
rvdw = 1.2
constraint_algorithm = lincs
lincs-iter = 1
lincs-order = 4
constraints = h-bonds
tcoupl = v-rescale
tc_grps = MEMBRANE SOLV
tau_t = 1.0 1.0
ref_t = 310.15 310.15
pcoupl = C-rescale
pcoupltype = semiisotropic
tau_p = 5.0
compressibility = 4.5e-5 4.5e-5
ref_p = 1.0 1.0
nstcomm = 100
comm_grps = MEMBRANE SOLV
refcoord_scaling = com
gen-vel = yes
gen-temp = 310.15
gen-seed = -1
