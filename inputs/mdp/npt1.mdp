define = -DPOSRES
integrator = md
dt = 0.002
nsteps = 250000        ; 500 ps restrained NPT
nstlog = 5000
nstenergy = 5000
continuation = yes
cutoff-scheme = Verlet
nstlist = 20
rlist = 1.2
coulombtype = pme
rcoulomb = 1.2
vdwtype = cut-off
vdw-modifier = force-switch
rvdw-switch = 1.0
rvdw = 1.2
constraint_algorithm = lincs
lincs-iter = 1
lincs-order = 4
constraints = h-bonds
tcoupl = v-rescale
tc_grps = MEMBRANE SOLV
tau_t = 1.0 1.0
ref_t = 310.15 310.15
nstcomm = 100
comm_mode = linear
comm_grps = MEMBRANE SOLV
refcoord_scaling = com
pcoupl = c-rescale
pcoupltype = semiisotropic
tau_p = 5.0
compressibility = 4.5e-5 4.5e-5
ref_p = 1.0 1.0
gen-vel = no
